# Test-run profile: the app runs on your PC (or Render); the model and embeddings run on a Colab GPU.
# Copy to .env, then paste the three values printed by the last cell of colab/hamar_gyan_gpu.ipynb
# (URL, API key, and the model tag). The URL and key change whenever the notebook is restarted.
# Demo data only: questions typed into the app are sent to the Colab VM.

HS_ENVIRONMENT=development
HS_ALLOW_DEMO_DATA=true

HS_SLM_RUNTIME=ollama
HS_SLM_URL=https://REPLACE-ME.trycloudflare.com
HS_SLM_API_KEY=REPLACE-ME
HS_SLM_MODEL=gemma4:31b-it-q4_K_M
# Reasoning models would spend the 700-token answer budget on "thinking"; ask Ollama not to think.
HS_SLM_THINK=false
HS_SLM_CONTEXT_TOKENS=8192
HS_SLM_TIMEOUT_SECONDS=300

# Embeddings are computed on the Colab GPU too. Vectors are cached on the app host in HS_KB_DIR,
# so re-ingesting or restarting the app does not re-embed unchanged passages.
HS_EMBEDDING_MODEL=ollama:bge-m3
HS_KB_DIR=data/kb

# Voice stays off unless you install requirements-voice.txt locally.
HS_STT_MODEL=
