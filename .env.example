# Copy to .env and adjust. All variables use the HS_ prefix.

# development | test | production
HS_ENVIRONMENT=development

# PostgreSQL in production, e.g. postgresql+psycopg://hamar:***@db.internal:5432/hamar_shiksha
HS_DATABASE_URL=sqlite:///./hamar_shiksha.db

# Random value of at least 32 characters in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HS_SECRET_KEY=dev-only-insecure-secret-change-me

# HTTPS-only cookies + HSTS. Must be true in production.
HS_COOKIE_SECURE=false

# Demo data must be false in production (demo school codes are then rejected).
HS_ALLOW_DEMO_DATA=true

# Require two-step verification for every administrator login.
HS_ADMIN_MFA_REQUIRED=false

# Session lifetimes (minutes)
HS_SESSION_TTL_MINUTES=480
HS_ADMIN_SESSION_TTL_MINUTES=60

# Brute-force protection
HS_LOGIN_MAX_ATTEMPTS=5
HS_LOGIN_WINDOW_MINUTES=15
HS_LOCKOUT_MINUTES=15
HS_IP_MAX_ATTEMPTS=30

# A school's data counts as "current" if its latest record is this recent.
HS_DATA_CURRENT_DAYS=35

# Retention (days), applied by: python -m app.cli purge-retention
HS_RETENTION_AI_INTERACTIONS_DAYS=180
HS_RETENTION_SESSIONS_DAYS=30
HS_RETENTION_LOGIN_ATTEMPTS_DAYS=30
HS_RETENTION_AUDIT_DAYS=2555

# ---- Gyan SLM (primary AI engine, runs locally) ----
# ollama | llamacpp | none | anthropic (optional central cloud inference - explicit opt-in only)
HS_SLM_RUNTIME=ollama
HS_SLM_URL=http://127.0.0.1:11434
HS_SLM_MODEL=llama3.2:3b
# Remote GPU runtime behind a token-checking proxy (see docs/DEPLOY_COLAB.md); leave unset for local Ollama.
# HS_SLM_API_KEY=
# Reasoning models (Gemma 4, Qwen 3): false stops hidden thinking from using the answer budget.
# HS_SLM_THINK=false
HS_SLM_CONTEXT_TOKENS=4096
HS_SLM_MAX_TOKENS=700
HS_SLM_TEMPERATURE=0.2

# Curriculum retrieval: empty = keyword (BM25) only. Hybrid multilingual (recommended):
#   ollama:bge-m3  -> embeddings from the local Ollama server (uses its GPU; `ollama pull bge-m3`)
#   BAAI/bge-m3    -> in-process sentence-transformers (pip install -r requirements-embeddings.txt; CPU is slow)
HS_EMBEDDING_MODEL=ollama:bge-m3
HS_KB_DIR=data/kb
HS_RETRIEVAL_TOP_K=4
HS_RETRIEVAL_MIN_VECTOR_SCORE=0.45

# Voice input: local Whisper speech-to-text (pip install -r requirements-voice.txt).
# "small" = better Hindi, about 1 s per second of speech on a laptop CPU; "base" = faster; "" = off.
HS_STT_MODEL=small
HS_STT_MAX_SECONDS=30

# Only if HS_SLM_RUNTIME=anthropic is deliberately chosen for centralised inference:
# HS_ANTHROPIC_API_KEY=
# HS_AI_MODEL=claude-opus-5-5

# Password-reset delivery: "log" (development only) or the approved SMS/e-mail gateway.
HS_NOTIFIER=log
